# Скопируй этот файл в .env и заполни значения. .env в git не попадает (см. .gitignore).

# --- Twitch (общее) ---
# Client ID и Client Secret своего Twitch-приложения:
# https://dev.twitch.tv/console/apps -> Register Your Application
#   Category: Application Integration
#   OAuth Redirect URLs — добавь:
#     http://localhost:8889/callback         (нужен для npm run auth:twitch, см. ниже)
#   Важно: у Twitch именно "localhost", а не "127.0.0.1" — с 127.0.0.1
#   консоль ругается "URL-адреса должны использовать протокол HTTPS"
#   (для http разрешено только буквально "localhost").
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Логин канала (как в адресе twitch.tv/<login>), нижним регистром
TWITCH_BROADCASTER_LOGIN=

# Числовой id канала (не логин). Узнать: npm run whoami:twitch -- <login>
TWITCH_BROADCASTER_ID=

# Как часто опрашивать Twitch API на предмет "стрим начался", мс (по умолчанию 60000 = 1 минута)
TWITCH_POLL_INTERVAL_MS=60000

# --- Telegram ---
# Обе переменные ниже необязательны — но именно как пара: либо заполни обе,
# либо не заполняй ни одной. Если не заполнены — анонсы в Telegram просто
# отключаются (при старте будет разовое предупреждение в лог), остальная
# часть приложения (заказ музыки и т.п.) работает как обычно. Если заполнена
# только одна из двух — приложение откажется стартовать с понятной ошибкой
# (это почти наверняка недосмотр, а не осознанный выбор).

# Токен бота от @BotFather (команда /newbot)
TELEGRAM_BOT_TOKEN=

# ID чата/канала, куда слать анонсы.
# Для канала: добавь бота туда админом, перешли любое сообщение из канала
# боту @userinfobot или используй https://api.telegram.org/bot<TOKEN>/getUpdates
# Для личного чата с ботом: напиши боту что-нибудь и посмотри chat.id в getUpdates
TELEGRAM_CHAT_ID=

# --- Заказ музыки: чат Twitch ---
# Аккаунт, от имени которого бот читает/пишет в чат и от имени которого
# проходится одноразовая авторизация (npm run auth:twitch).
# Если это сам стример — впиши тот же логин, что и TWITCH_BROADCASTER_LOGIN.
# Если отдельный бот-аккаунт — он должен быть модератором канала
# (иначе не будет работать проверка даты фолловера).
TWITCH_CHAT_BOT_USERNAME=

# Куда сохранить токен после npm run auth:twitch (создастся автоматически)
TWITCH_CHAT_TOKEN_FILE=./data/twitch-chat-token.json

# Redirect URI для npm run auth:twitch — должен быть добавлен в настройках
# приложения на dev.twitch.tv/console/apps (см. блок Twitch выше)
TWITCH_CHAT_REDIRECT_URI=http://localhost:8889/callback

# Команда заказа музыки в чате
MUSIC_COMMAND=!sr

# Команда "текущий трек" — показывает в чате, что сейчас играет
MUSIC_CURRENT_COMMAND=!s

# Минимальный "стаж" подписки (фолловинга), чтобы разрешить заказ, дней
MUSIC_MIN_FOLLOWER_DAYS=3

# --- Заказ музыки: скип трека голосованием ---
# Команда скипа текущего трека в чате. Стример скипает ей сразу, без порога
# (полезно для YouTube-заказов, которые иначе не переключить). Зрители —
# голосованием: трек скипается, когда голосов наберётся не меньше
# MUSIC_SKIP_THRESHOLD_PERCENT процентов от числа "активных" в чате —
# уникальных зрителей, написавших что-либо (не обязательно !skip) за
# последние MUSIC_SKIP_ACTIVE_WINDOW_MS. Общее число зрителей стрима
# приложению взять неоткуда, поэтому порог считается именно так.
MUSIC_SKIP_COMMAND=!skip
MUSIC_SKIP_THRESHOLD_PERCENT=30
MUSIC_SKIP_ACTIVE_WINDOW_MS=600000

# --- Заказ музыки: приостановка приёма заказов ---
# Доступно только стримеру и модераторам. Пока приостановлено — новые заказы
# отклоняются, а дефолтный плейлист (если настроен Spotify) тоже не играет.
MUSIC_PAUSE_COMMAND=!pr
MUSIC_RESUME_COMMAND=!rr

# --- Заказ музыки: YouTube ---
# API-ключ (не OAuth) с включённым YouTube Data API v3:
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Максимальная длительность видео для заказа, сек (по умолчанию 600 = 10 минут)
YOUTUBE_MAX_DURATION_SEC=600

# --- Заказ музыки: обход блокировок YouTube ("Sign in to confirm you're
#     not a bot", "The page needs to be reloaded" и подобных) ---
# Это про ЛОКАЛЬНОЕ воспроизведение через mpv/yt-dlp (см. MPV_PATH ниже), а
# не про YOUTUBE_API_KEY выше — это два разных, независимых обращения к
# YouTube. Такие ошибки — массовая, известная история YouTube-vs-yt-dlp,
# а не что-то специфичное для конкретного видео или баг в этом коде.
# ВАЖНО: YouTube и yt-dlp постоянно меняют правила игры — то, что работает
# сегодня, может перестать работать через месяц, и наоборот. Если заказ
# перестал воспроизводиться — начни с обновления yt-dlp (см. README, раздел
# про установку), и только потом крути настройки ниже.
#
# Под какого "клиента" YouTube маскируется yt-dlp (может быть несколько
# через запятую). "tv,web_safari,web_embedded" — сочетание, которое на
# момент написания этого файла реже всего упирается и в проверку "не бот",
# и в ошибку "The page needs to be reloaded". Специально исключено
# "android"-семейство клиентов (android, android_vr и т.п.) — сейчас у них
# особенно часто ловится HTTP 403 Forbidden уже на самом проигрывании,
# после того как ссылка успешно разобралась (см. YOUTUBE_FORCE_IPV4 ниже —
# это тот случай). Если перестанет работать — актуальный список клиентов и
# что для них нужно: https://github.com/yt-dlp/yt-dlp/wiki/PO-Token-Guide
# Важный нюанс: если ниже задан YOUTUBE_COOKIES_FROM_BROWSER/_FILE, клиент
# "tv" автоматически заменяется yt-dlp на "tv_downgraded" — стоит иметь в
# виду, если что-то не работает именно в сочетании с куками.
YOUTUBE_PLAYER_CLIENT=web_safari,web_embedded

# Если смены YOUTUBE_PLAYER_CLIENT недостаточно — можно дополнительно
# передать yt-dlp куки из браузера (обычно решает проблему полностью).
# Значение — имя браузера: firefox, chrome, edge, brave, vivaldi, opera.
# На Windows надёжнее всего firefox (не требует закрытия браузера и не
# упирается в шифрование куки Chrome). Для chrome/edge/brave и т.п. браузер
# на момент запуска должен быть полностью закрыт.
YOUTUBE_COOKIES_FROM_BROWSER=

# Альтернатива YOUTUBE_COOKIES_FROM_BROWSER — путь к cookies.txt (формат
# Netscape, например экспортированный расширением "Get cookies.txt").
# Используется, только если YOUTUBE_COOKIES_FROM_BROWSER не задан.
YOUTUBE_COOKIES_FILE=

# Необязательно. Явный путь к исполняемому файлу yt-dlp (например
# C:\tools\yt-dlp.exe), если на машине их несколько (скажем, winget
# поставил один, а рядом вручную положен более свежий .exe) — mpv по
# умолчанию берёт первый yt-dlp, который найдёт в PATH, и это не всегда
# тот, который реально обновлялся через "yt-dlp -U". Если не уверен —
# оставь пустым.
YTDLP_PATH=

# Необязательно. Если YouTube-заказ доходит до "нашёл ссылку на видео", но
# падает на самом проигрывании с "HTTP error 403 Forbidden" (mpv/ffmpeg не
# может скачать сам файл) — причина обычно в том, что ссылка на видео
# привязана к IP, с которого её запросил yt-dlp, а твой компьютер отдельно
# подключается по другому IP (типичная история на сетях, где одновременно
# доступны IPv4 и IPv6). true — заставляет yt-dlp запрашивать ссылку только
# по IPv4, что решает это иногда, но не всегда (у mpv нет отдельного способа
# гарантированно использовать тот же IP уже для самого проигрывания) — если
# не помогло, следующий шаг уже на уровне Windows (отключить/понизить
# приоритет IPv6 в свойствах сетевого адаптера).
YOUTUBE_FORCE_IPV4=false

# Громкость mpv при старте YouTube-заказа, 0-100 (по умолчанию 50). Раньше
# mpv стартовал со своей дефолтной громкостью (обычно заметно громче, чем
# играл до этого Spotify) — теперь YouTube-заказ сразу включается вполовину
# громкости, не оглушая.
MPV_VOLUME=50

# --- Заказ музыки: Spotify ---
# Все три переменные ниже (SPOTIFY_CLIENT_ID/SPOTIFY_CLIENT_SECRET/
# SPOTIFY_DEFAULT_PLAYLIST_URI) необязательны — но как единая группа: либо
# заполни все три, либо не заполняй ни одной. Если не заполнены — интеграция
# со Spotify целиком отключается (разовое предупреждение в лог при старте),
# и заказ музыки работает только по YouTube-ссылкам (и через текстовый поиск
# по названию, если он всё же настроен — см. ниже). Если заполнена только
# часть — приложение откажется стартовать с понятной ошибкой.
#
# Client ID/Secret приложения: https://developer.spotify.com/dashboard
#   Redirect URI в настройках приложения — добавь:
#     http://127.0.0.1:8888/callback
#   Важно: у Spotify наоборот, чем у Twitch — для http требуется именно
#   "127.0.0.1", а "localhost" Spotify не принимает.
#   Нужен Spotify Premium — без него Web API не может управлять воспроизведением.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Redirect URI для npm run auth:spotify
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Куда сохранить токен после npm run auth:spotify (создастся автоматически)
SPOTIFY_TOKEN_FILE=./data/spotify-token.json

# Дефолтный плейлист, который играет, пока нет заказов.
# Проще всего: Spotify -> ... (три точки у плейлиста) -> Share -> Copy link to playlist —
# полученную ссылку вида https://open.spotify.com/playlist/<id>?si=... можно
# вставить прямо сюда как есть, приложение само приведёт её к нужному виду.
# Также подойдёт голый id плейлиста или spotify:playlist:<id> (Copy Spotify URI,
# если эта опция у тебя есть — Spotify то убирает, то возвращает её в разных версиях).
SPOTIFY_DEFAULT_PLAYLIST_URI=

# Заказ в Spotify можно оформить не только ссылкой, но и текстом (например
# "Never Gonna Give You Up" или "Rick Astley - Never Gonna Give You Up") —
# работает автоматически, если Spotify настроен (см. группу выше), отдельно
# включать не нужно. Приложение берёт первый результат поиска Spotify по
# этому тексту — то же самое, что показал бы поиск в самом приложении
# Spotify первым пунктом. Если результатов вообще нет — отказ.

# Как часто опрашивать Spotify Player API, мс (по умолчанию 4000)
SPOTIFY_POLL_INTERVAL_MS=4000

# За сколько мс до конца трека считать его "почти закончившимся" и
# пропускать заказ вперёд (по умолчанию 5000).
# ВАЖНО: должно быть >= SPOTIFY_POLL_INTERVAL_MS, иначе можно проскочить
# момент конца трека между двумя опросами и не заметить его вовремя —
# заказ тогда не подхватывается, и кажется, что "переключение не работает"
# (на самом деле это гонка между этими двумя настройками). Если всё же
# укажешь меньше — приложение само поднимет значение до
# SPOTIFY_POLL_INTERVAL_MS и напишет об этом предупреждение в лог.
SPOTIFY_END_THRESHOLD_MS=5000

# Необязательно, но настоятельно рекомендуется. Точное имя устройства
# Spotify Connect (например, имя твоего ПК), на котором должна играть
# музыка. Без этого Spotify Web API требует, чтобы у аккаунта уже было
# "активное устройство" — иначе воспроизведение падает с HTTP 404
# ("NO_ACTIVE_DEVICE"), даже если Spotify открыт. Узнать точное имя:
#   node scripts/spotify-devices.ts
# (нужно, чтобы на устройстве уже был запущен Spotify — иначе список пуст)
SPOTIFY_DEVICE_NAME=

# --- Заказ музыки: воспроизведение YouTube ---
# Путь к исполняемому файлу mpv. Если mpv есть в PATH — можно оставить "mpv".
# Также требуется установленный yt-dlp (его использует mpv для YouTube-ссылок).
MPV_PATH=mpv

# Необязательно. На какое аудио-устройство mpv должен выводить звук
# YouTube-заказов — вместо устройства по умолчанию (то есть вместо тех же
# колонок/наушников, куда играет всё остальное). Нужно, чтобы в OBS можно
# было захватить звук именно этих заказов отдельно — обычно через
# виртуальный аудио-кабель вроде VB-CABLE (см. README, раздел "Про звук
# YouTube-заказов в OBS" — там пошаговая инструкция целиком, от установки
# VB-CABLE до настройки источника в OBS).
#
# Как узнать точное значение (Windows, после установки VB-CABLE):
#   mpv --audio-device=help
# В выводе найди строку с "CABLE Input" — нужно значение в кавычках перед
# ним, вида wasapi/{05...-....-....-....-............}. Скопируй его сюда
# целиком, включая фигурные скобки.
MPV_AUDIO_DEVICE=

# --- Хранилище ---
# Путь к файлу SQLite (создастся автоматически)
DB_PATH=./data/stream-companion.sqlite
